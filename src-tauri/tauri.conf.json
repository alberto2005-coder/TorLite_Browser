{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TorLite Browser",
  "version": "0.1.0",
  "identifier": "com.alors.tauri-app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TorLite Browser - Connecting",
        "url": "bootstrap.html",
        "width": 450,
        "height": 320,
        "resizable": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
